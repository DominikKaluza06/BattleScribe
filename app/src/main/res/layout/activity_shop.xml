<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/inv_background"
    tools:context=".ShopActivity">

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="#AA000000"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/shop_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_shop"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/imageView2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/shop_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#AA000000"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView2" />

    <TextView
        android:id="@+id/tv_gold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:text="Gold: 0"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/shop_overlay" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/label_items_for_sale"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/shop_overlay" />

    <!-- Shop Slots -->
    <GridLayout
        android:id="@+id/shop_grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2">

        <ImageView android:id="@+id/shop_slot1" android:layout_width="55dp" android:layout_height="56dp" android:layout_margin="8dp" android:background="#44FFFFFF" />
        <ImageView android:id="@+id/shop_slot2" android:layout_width="55dp" android:layout_height="56dp" android:layout_margin="8dp" android:background="#44FFFFFF" />
        <ImageView android:id="@+id/shop_slot3" android:layout_width="55dp" android:layout_height="56dp" android:layout_margin="8dp" android:background="#44FFFFFF" />
        <ImageView android:id="@+id/shop_slot4" android:layout_width="55dp" android:layout_height="56dp" android:layout_margin="8dp" android:background="#44FFFFFF" />
        <ImageView android:id="@+id/shop_slot5" android:layout_width="55dp" android:layout_height="56dp" android:layout_margin="8dp" android:background="#44FFFFFF" />
        <ImageView android:id="@+id/shop_slot6" android:layout_width="55dp" android:layout_height="56dp" android:layout_margin="8dp" android:background="#44FFFFFF" />
        <ImageView android:id="@+id/shop_slot7" android:layout_width="55dp" android:layout_height="56dp" android:layout_margin="8dp" android:background="#44FFFFFF" />
        <ImageView android:id="@+id/shop_slot8" android:layout_width="55dp" android:layout_height="56dp" android:layout_margin="8dp" android:background="#44FFFFFF" />
    </GridLayout>

    <TextView
        android:id="@+id/textView_inventory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/label_your_inventory"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shop_grid" />

    <!-- Inventory Slots -->
    <GridLayout
        android:id="@+id/inventory_grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_inventory">

        <ImageView android:id="@+id/sell_slot1" android:layout_width="55dp" android:layout_height="56dp" android:layout_margin="8dp" android:background="#44FFFFFF" />
        <ImageView android:id="@+id/sell_slot2" android:layout_width="55dp" android:layout_height="56dp" android:layout_margin="8dp" android:background="#44FFFFFF" />
        <ImageView android:id="@+id/sell_slot3" android:layout_width="55dp" android:layout_height="56dp" android:layout_margin="8dp" android:background="#44FFFFFF" />
        <ImageView android:id="@+id/sell_slot4" android:layout_width="55dp" android:layout_height="56dp" android:layout_margin="8dp" android:background="#44FFFFFF" />
        <ImageView android:id="@+id/sell_slot5" android:layout_width="55dp" android:layout_height="56dp" android:layout_margin="8dp" android:background="#44FFFFFF" />
        <ImageView android:id="@+id/sell_slot6" android:layout_width="55dp" android:layout_height="56dp" android:layout_margin="8dp" android:background="#44FFFFFF" />
        <ImageView android:id="@+id/sell_slot7" android:layout_width="55dp" android:layout_height="56dp" android:layout_margin="8dp" android:background="#44FFFFFF" />
        <ImageView android:id="@+id/sell_slot8" android:layout_width="55dp" android:layout_height="56dp" android:layout_margin="8dp" android:background="#44FFFFFF" />
    </GridLayout>

    <!-- Item Description Panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_info_panel"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="#EE000000"
        android:padding="8dp"
        android:visibility="invisible"
        android:elevation="10dp"
        app:layout_constraintBottom_toTopOf="@+id/shop_page_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/selected_item_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/selected_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/placeholder_item_name"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/selected_item_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/selected_item_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_stats"
            android:textColor="#BBBBBB"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/selected_item_name"
            app:layout_constraintTop_toBottomOf="@+id/selected_item_name" />

        <Button
            android:id="@+id/action_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_buy"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
            
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageButton
        android:id="@+id/shop_next_page"
        android:layout_width="40dp"
        android:layout_height="30dp"
        android:layout_marginEnd="32dp"
        android:background="@android:color/transparent"
        android:onClick="SHOPnextPage"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/shop_page_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/shop_page_text"
        app:srcCompat="@drawable/button_right" />

    <ImageButton
        android:id="@+id/shop_prev_page"
        android:layout_width="40dp"
        android:layout_height="30dp"
        android:layout_marginStart="32dp"
        android:background="@android:color/transparent"
        android:onClick="SHOPprevPage"
        android:rotationY="180"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/shop_page_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/shop_page_text"
        app:srcCompat="@drawable/button_right" />

    <TextView
        android:id="@+id/shop_page_text"
        android:layout_width="60dp"
        android:layout_height="30dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="@string/placeholder_page"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:background="#222222"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView android:id="@+id/shop" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="12dp" android:background="#44FFFFFF" app:srcCompat="@android:drawable/ic_menu_compass" />
        <ImageView android:id="@+id/skills" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="12dp" app:srcCompat="@android:drawable/ic_menu_manage" />
        <ImageView android:id="@+id/adventure" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="12dp" app:srcCompat="@android:drawable/ic_menu_mapmode" />
        <ImageView android:id="@+id/crafting" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="12dp" app:srcCompat="@android:drawable/ic_menu_edit" />
        <ImageView android:id="@+id/character" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="12dp" app:srcCompat="@android:drawable/ic_menu_myplaces" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
