<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/inv_background"
    tools:context=".BattleChoiceActivity">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <ImageView
        android:id="@+id/header_bg"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@drawable/medium_background"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/battle_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_adventure"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowRadius="3"
        app:layout_constraintBottom_toBottomOf="@+id/header_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- STEP 1: Main Mode Selection -->
    <LinearLayout
        android:id="@+id/layout_main_choice"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/nav_top_line"
        app:layout_constraintTop_toBottomOf="@+id/header_bg">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_story"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_margin="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/medium_background"
                android:padding="16dp">

                <TextView
                    android:id="@+id/story_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/story_mode_title"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/story_mode_desc"
                    android:textColor="#DDDDDD"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/story_title" />

                <Button
                    android:id="@+id/btn_continue_story"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_continue_story"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/card_adventure_mode"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_margin="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/medium_background"
                android:padding="16dp">

                <TextView
                    android:id="@+id/adv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADVENTURE MODE"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Travel to different biomes to fight monsters and gather materials."
                    android:textColor="#DDDDDD"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/adv_title" />

                <Button
                    android:id="@+id/btn_to_biomes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GO TO BIOMES"
                    android:backgroundTint="#2196F3"
                    android:textColor="#FFFFFF"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- STEP 2: Biome Selection Screen -->
    <LinearLayout
        android:id="@+id/layout_biome_selection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/nav_top_line"
        app:layout_constraintTop_toBottomOf="@+id/header_bg">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_forest"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_margin="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/medium_background"
                android:padding="16dp">

                <TextView
                    android:id="@+id/forest_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DARK FOREST"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="A dense woods filled with zombies and skeletons. Great for early resources."
                    android:textColor="#DDDDDD"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/forest_title" />

                <Button
                    android:id="@+id/btn_enter_forest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GO TO FOREST"
                    android:backgroundTint="#2E7D32"
                    android:textColor="#FFFFFF"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btn_back_to_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:text="BACK"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- STEP 3: Biome Action Screen (Fight/Leave) -->
    <LinearLayout
        android:id="@+id/layout_biome_actions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/nav_top_line"
        app:layout_constraintTop_toBottomOf="@+id/header_bg">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/medium_background"
            android:padding="24dp">

            <TextView
                android:id="@+id/tv_biome_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DARK FOREST"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:layout_marginBottom="32dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btn_biome_fight"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="SEARCH FOR FIGHT"
                android:backgroundTint="#FF4444"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_biome_name" />

            <Button
                android:id="@+id/btn_biome_leave"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="LEAVE BIOME"
                android:layout_marginTop="16dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#FFFFFF"
                app:strokeColor="#FFFFFF"
                app:layout_constraintTop_toBottomOf="@+id/btn_biome_fight" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <!-- Bottom Navigation -->
    <View
        android:id="@+id/nav_top_line"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#3E2723"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/light_background"
        android:elevation="10dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/shop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            app:srcCompat="@drawable/shop" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#3E2723" />

        <ImageView
            android:id="@+id/skills"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="2dp"
            app:srcCompat="@drawable/skills" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#3E2723" />

        <ImageView
            android:id="@+id/adventure"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#44FFFFFF"
            android:padding="12dp"
            app:srcCompat="@drawable/map" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#3E2723" />

        <ImageView
            android:id="@+id/crafting"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            app:srcCompat="@drawable/crafting" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#3E2723" />

        <ImageView
            android:id="@+id/character"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            app:srcCompat="@drawable/charcter" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
