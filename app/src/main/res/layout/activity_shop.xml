<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/inv_background"
    tools:context=".ShopActivity">

    <!-- Overall Dark Filter -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- 1. Header Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/shop_header"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="@drawable/medium_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/shop_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_shop"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/tv_gold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tv_gold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gold: 0"
            android:textColor="#FFD700"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/shop_title" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. Shop Inventory (Items for Sale) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/shop_inventory_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/light_background"
        app:layout_constraintBottom_toTopOf="@+id/separator_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shop_header"
        app:layout_constraintVertical_weight="1">

        <TextView
            android:id="@+id/label_items_sale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:text="@string/label_items_for_sale"
            android:textColor="#3E2723"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <GridLayout
            android:id="@+id/shop_grid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="2"
            app:layout_constraintBottom_toTopOf="@+id/shop_page_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/label_items_sale">

            <FrameLayout android:layout_width="65dp" android:layout_height="65dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/shop_slot1" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="65dp" android:layout_height="65dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/shop_slot2" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="65dp" android:layout_height="65dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/shop_slot3" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="65dp" android:layout_height="65dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/shop_slot4" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="65dp" android:layout_height="65dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/shop_slot5" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="65dp" android:layout_height="65dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/shop_slot6" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="65dp" android:layout_height="65dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/shop_slot7" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="65dp" android:layout_height="65dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/shop_slot8" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:scaleType="fitCenter" />
            </FrameLayout>
        </GridLayout>

        <ImageButton
            android:id="@+id/shop_prev_page"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:layout_marginStart="32dp"
            android:background="@android:color/transparent"
            android:onClick="SHOPprevPage"
            android:rotationY="180"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/shop_page_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/shop_page_text"
            app:srcCompat="@drawable/button_right" />

        <TextView
            android:id="@+id/shop_page_text"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:text="1/3"
            android:textColor="#3E2723"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/shop_next_page"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:layout_marginEnd="32dp"
            android:background="@android:color/transparent"
            android:onClick="SHOPnextPage"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/shop_page_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/shop_page_text"
            app:srcCompat="@drawable/button_right" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Separator Line -->
    <View
        android:id="@+id/separator_line"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#3E2723"
        app:layout_constraintBottom_toTopOf="@+id/player_inventory_layout"
        app:layout_constraintTop_toBottomOf="@+id/shop_inventory_layout" />

    <!-- 3. Player Inventory (Items to Sell) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/player_inventory_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/light_background"
        app:layout_constraintBottom_toTopOf="@+id/item_info_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/separator_line"
        app:layout_constraintVertical_weight="1">

        <TextView
            android:id="@+id/label_your_inv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:text="@string/label_your_inventory"
            android:textColor="#3E2723"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <GridLayout
            android:id="@+id/inventory_grid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="2"
            app:layout_constraintBottom_toTopOf="@+id/inv_page_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/label_your_inv">

            <FrameLayout android:layout_width="65dp" android:layout_height="65dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/sell_slot1" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="65dp" android:layout_height="65dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/sell_slot2" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="65dp" android:layout_height="65dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/sell_slot3" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="65dp" android:layout_height="65dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/sell_slot4" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="65dp" android:layout_height="65dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/sell_slot5" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="65dp" android:layout_height="65dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/sell_slot6" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="65dp" android:layout_height="65dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/sell_slot7" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="65dp" android:layout_height="65dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/sell_slot8" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:scaleType="fitCenter" />
            </FrameLayout>
        </GridLayout>

        <ImageButton
            android:id="@+id/inv_prev_page"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:layout_marginStart="32dp"
            android:background="@android:color/transparent"
            android:onClick="INVprevPage"
            android:rotationY="180"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/inv_page_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/inv_page_text"
            app:srcCompat="@drawable/button_right" />

        <TextView
            android:id="@+id/inv_page_text"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:text="1/3"
            android:textColor="#3E2723"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/inv_next_page"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:layout_marginEnd="32dp"
            android:background="@android:color/transparent"
            android:onClick="INVnextPage"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/inv_page_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/inv_page_text"
            app:srcCompat="@drawable/button_right" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 4. Info Panel (Always Visible Background) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_info_panel"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:background="@drawable/medium_background"
        android:padding="12dp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/nav_top_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_inventory_layout">

        <ImageView
            android:id="@+id/selected_item_icon"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/selected_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/action_button"
            app:layout_constraintStart_toEndOf="@+id/selected_item_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/selected_item_desc"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:textColor="#DDDDDD"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/action_button"
            app:layout_constraintStart_toEndOf="@+id/selected_item_icon"
            app:layout_constraintTop_toBottomOf="@+id/selected_item_name" />

        <Button
            android:id="@+id/action_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#4CAF50"
            android:text="ACTION"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/close_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="closeInfoPanel"
            android:text="CLOSE"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 5. Bottom Navigation with separators and light background -->
    <View
        android:id="@+id/nav_top_line"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#3E2723"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/light_background"
        android:elevation="10dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/shop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#44FFFFFF"
            android:padding="12dp"
            app:srcCompat="@drawable/shop" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#3E2723" />

        <ImageView
            android:id="@+id/skills"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="2dp"
            app:srcCompat="@drawable/skills" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#3E2723" />

        <ImageView
            android:id="@+id/adventure"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            app:srcCompat="@drawable/map" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#3E2723" />

        <ImageView
            android:id="@+id/crafting"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            app:srcCompat="@drawable/crafting" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#3E2723" />

        <ImageView
            android:id="@+id/character"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            app:srcCompat="@drawable/charcter" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
