<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/inv_background"
    tools:context=".Character">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- TOP SECTION: STATS -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/stats_header"
        android:layout_width="0dp"
        android:layout_height="280dp"
        android:background="@drawable/medium_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/character_frame_layout"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/frame" />

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="8dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/maincharacter" />
        </FrameLayout>

        <!-- Info stack: Level, Gold, Points stacked vertically under image -->
        <LinearLayout
            android:id="@+id/info_stack"
            android:layout_width="140dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:gravity="start"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/character_frame_layout">

            <TextView
                android:id="@+id/tv_level"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Level: 1"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_char_gold"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Gold: 0"
                android:textColor="#FFD700"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_stat_points"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Points: 0"
                android:textColor="#00FF00"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Stats Column: STR, VIT, MGC, AGI -->
        <LinearLayout
            android:id="@+id/stats_column"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/info_stack"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
                <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="STR:" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_STR" android:layout_width="50dp" android:layout_height="wrap_content" android:text="10" android:textColor="#FFFFFF" android:textSize="18sp" />
                <ImageButton android:layout_width="35dp" android:layout_height="35dp" android:onClick="increaseStr" android:src="@drawable/plus" android:background="?android:attr/selectableItemBackgroundBorderless" android:scaleType="fitCenter" android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
                <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="VIT:" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_VIT" android:layout_width="50dp" android:layout_height="wrap_content" android:text="10" android:textColor="#FFFFFF" android:textSize="18sp" />
                <ImageButton android:layout_width="35dp" android:layout_height="35dp" android:onClick="increaseVit" android:src="@drawable/plus" android:background="?android:attr/selectableItemBackgroundBorderless" android:scaleType="fitCenter" android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
                <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="MGC:" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_MGC" android:layout_width="50dp" android:layout_height="wrap_content" android:text="10" android:textColor="#FFFFFF" android:textSize="18sp" />
                <ImageButton android:layout_width="35dp" android:layout_height="35dp" android:onClick="increaseMgc" android:src="@drawable/plus" android:background="?android:attr/selectableItemBackgroundBorderless" android:scaleType="fitCenter" android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
                <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="AGI:" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_AGI" android:layout_width="50dp" android:layout_height="wrap_content" android:text="10" android:textColor="#FFFFFF" android:textSize="18sp" />
                <ImageButton android:layout_width="35dp" android:layout_height="35dp" android:onClick="increaseAgi" android:src="@drawable/plus" android:background="?android:attr/selectableItemBackgroundBorderless" android:scaleType="fitCenter" android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- EQUIPMENT AREA -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/equipment_section"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@drawable/light_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stats_header">

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:text="@string/label_equipment"
            android:textColor="#3E2723"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView2">

            <FrameLayout android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" android:contentDescription="@null" />
                <ImageView android:id="@+id/weapon_slot" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:scaleType="fitCenter" android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" android:contentDescription="@null" />
                <ImageView android:id="@+id/helmet_slot" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:scaleType="fitCenter" android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" android:contentDescription="@null" />
                <ImageView android:id="@+id/armor_slot" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:scaleType="fitCenter" android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" android:contentDescription="@null" />
                <ImageView android:id="@+id/boots_slot" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:scaleType="fitCenter" android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="4dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" android:contentDescription="@null" />
                <ImageView android:id="@+id/ring_slot" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:scaleType="fitCenter" android:contentDescription="@null" />
            </FrameLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- INVENTORY GRID -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/inventory_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/nav_top_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/equipment_section">

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="2"
            app:layout_constraintBottom_toTopOf="@+id/INVsitePage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="6dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" android:contentDescription="@null" />
                <ImageView android:id="@+id/weapon_slot1" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp" android:scaleType="fitCenter" android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="6dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" android:contentDescription="@null" />
                <ImageView android:id="@+id/weapon_slot2" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp" android:scaleType="fitCenter" android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="6dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" android:contentDescription="@null" />
                <ImageView android:id="@+id/weapon_slot3" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp" android:scaleType="fitCenter" android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="6dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" android:contentDescription="@null" />
                <ImageView android:id="@+id/weapon_slot4" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp" android:scaleType="fitCenter" android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="6dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" android:contentDescription="@null" />
                <ImageView android:id="@+id/weapon_slot5" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp" android:scaleType="fitCenter" android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="6dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" android:contentDescription="@null" />
                <ImageView android:id="@+id/weapon_slot6" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp" android:scaleType="fitCenter" android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="6dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" android:contentDescription="@null" />
                <ImageView android:id="@+id/weapon_slot7" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp" android:scaleType="fitCenter" android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="6dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" android:contentDescription="@null" />
                <ImageView android:id="@+id/weapon_slot8" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp" android:scaleType="fitCenter" android:contentDescription="@null" />
            </FrameLayout>
        </GridLayout>

        <ImageButton
            android:id="@+id/imageButton3"
            android:layout_width="50dp"
            android:layout_height="40dp"
            android:layout_marginStart="32dp"
            android:background="@android:color/transparent"
            android:onClick="INVprevPage"
            android:rotationY="180"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/INVsitePage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/INVsitePage"
            app:srcCompat="@drawable/button_right"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/INVsitePage"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="1/3"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/imageButton2"
            android:layout_width="50dp"
            android:layout_height="40dp"
            android:layout_marginEnd="32dp"
            android:background="@android:color/transparent"
            android:onClick="INVnextPage"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/INVsitePage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/INVsitePage"
            app:srcCompat="@drawable/button_right"
            android:contentDescription="@null" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- INFO OVERLAY -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/char_item_info_panel"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_margin="16dp"
        android:background="@drawable/medium_background"
        android:padding="16dp"
        android:visibility="gone"
        android:elevation="20dp"
        app:layout_constraintBottom_toTopOf="@+id/nav_top_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView android:id="@+id/selected_char_item_icon" android:layout_width="80dp" android:layout_height="80dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" android:contentDescription="@null" />
        <TextView android:id="@+id/selected_char_item_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" app:layout_constraintEnd_toStartOf="@+id/char_item_action_button" app:layout_constraintStart_toEndOf="@+id/selected_char_item_icon" app:layout_constraintTop_toTopOf="parent" />
        <TextView android:id="@+id/selected_char_item_desc" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="16dp" android:textColor="#DDDDDD" android:textSize="14sp" app:layout_constraintBottom_toBottomOf="parent" android:layout_marginBottom="8dp" app:layout_constraintEnd_toStartOf="@+id/char_item_action_button" app:layout_constraintStart_toEndOf="@+id/selected_char_item_icon" app:layout_constraintTop_toBottomOf="@+id/selected_char_item_name" />
        <Button android:id="@+id/char_item_action_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:backgroundTint="#4CAF50" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <Button android:id="@+id/char_item_close_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CLOSE" style="@style/Widget.MaterialComponents.Button.TextButton" android:textColor="#FFFFFF" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- NAVIGATION -->
    <View
        android:id="@+id/nav_top_line"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#3E2723"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/light_background"
        android:elevation="10dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/shop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            app:srcCompat="@drawable/shop"
            android:contentDescription="@null" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#3E2723" />

        <ImageView
            android:id="@+id/skills"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="2dp"
            app:srcCompat="@drawable/skills"
            android:contentDescription="@null" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#3E2723" />

        <ImageView
            android:id="@+id/adventure"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            app:srcCompat="@drawable/map"
            android:contentDescription="@null" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#3E2723" />

        <ImageView
            android:id="@+id/crafting"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            app:srcCompat="@drawable/crafting"
            android:contentDescription="@null" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#3E2723" />

        <ImageView
            android:id="@+id/character"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#44FFFFFF"
            android:padding="12dp"
            app:srcCompat="@drawable/charcter"
            android:contentDescription="@null" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>