<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Character">

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="0dp"
        android:layout_height="241dp"
        android:background="#333333"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_horizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="128dp"
        android:layout_height="136dp"
        android:layout_marginStart="24dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="Character Avatar"
        app:layout_constraintBottom_toBottomOf="@+id/imageView2"
        app:layout_constraintStart_toStartOf="@+id/imageView2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.495" />

    <!-- Reset Button -->
    <Button
        android:id="@+id/btn_reset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="RESET"
        android:onClick="resetGame"
        android:backgroundTint="#FF4444"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:text="Level: 1"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView" />

    <TextView
        android:id="@+id/tv_char_gold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="Gold: 0"
        android:textColor="#FFD700"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/tv_level"
        app:layout_constraintStart_toEndOf="@+id/tv_level"
        app:layout_constraintTop_toTopOf="@+id/tv_level" />

    <TextView
        android:id="@+id/tv_stat_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:text="Stat Points: 0"
        android:textColor="#FFD700"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/tv_level"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_level" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="54dp"
        android:layout_height="30dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="12dp"
        android:text="STR:"
        android:textColor="#FBFAFA"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/textView3"
        app:layout_constraintStart_toEndOf="@+id/imageView"
        app:layout_constraintTop_toTopOf="@+id/imageView2"
        app:layout_constraintVertical_bias="0.926" />

    <TextView
        android:id="@+id/tv_STR"
        android:layout_width="70dp"
        android:layout_height="27dp"
        android:layout_marginStart="12dp"
        android:text="10"
        android:textColor="#FBFAFA"
        android:textSize="20sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/textView"
        app:layout_constraintStart_toEndOf="@+id/textView" />

    <TextView
        android:id="@+id/tv_DEF"
        android:layout_width="70dp"
        android:layout_height="27dp"
        android:text="10"
        android:textColor="#FBFAFA"
        android:textSize="20sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/textView3"
        app:layout_constraintEnd_toEndOf="@+id/tv_STR"
        app:layout_constraintStart_toStartOf="@+id/tv_STR" />

    <TextView
        android:id="@+id/tv_MGC"
        android:layout_width="70dp"
        android:layout_height="27dp"
        android:text="10"
        android:textColor="#FBFAFA"
        android:textSize="20sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/MGCtext"
        app:layout_constraintEnd_toEndOf="@+id/tv_DEF"
        app:layout_constraintStart_toStartOf="@+id/tv_DEF" />

    <TextView
        android:id="@+id/tv_AGI"
        android:layout_width="70dp"
        android:layout_height="27dp"
        android:text="10"
        android:textColor="#FBFAFA"
        android:textSize="20sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/AGItext"
        app:layout_constraintEnd_toEndOf="@+id/tv_MGC"
        app:layout_constraintStart_toStartOf="@+id/tv_MGC" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="54dp"
        android:layout_height="30dp"
        android:layout_marginTop="85dp"
        android:layout_marginBottom="12dp"
        android:text="DEF:"
        android:textColor="#FBFAFA"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/MGCtext"
        app:layout_constraintEnd_toEndOf="@+id/textView"
        app:layout_constraintStart_toStartOf="@+id/textView"
        app:layout_constraintTop_toTopOf="@+id/imageView2" />

    <TextView
        android:id="@+id/MGCtext"
        android:layout_width="54dp"
        android:layout_height="30dp"
        android:layout_marginTop="127dp"
        android:layout_marginBottom="12dp"
        android:text="MGC:"
        android:textColor="#FBFAFA"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/AGItext"
        app:layout_constraintEnd_toEndOf="@+id/textView3"
        app:layout_constraintStart_toStartOf="@+id/textView3"
        app:layout_constraintTop_toTopOf="@+id/imageView2" />

    <TextView
        android:id="@+id/AGItext"
        android:layout_width="54dp"
        android:layout_height="30dp"
        android:layout_marginTop="169dp"
        android:text="AGI:"
        android:textColor="#FBFAFA"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@+id/MGCtext"
        app:layout_constraintStart_toStartOf="@+id/MGCtext"
        app:layout_constraintTop_toTopOf="@+id/imageView2" />

    <ImageButton
        android:id="@+id/STRbtn"
        android:layout_width="31dp"
        android:layout_height="27dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="39dp"
        android:contentDescription="Increase Strength"
        android:onClick="increaseStr"
        app:layout_constraintBottom_toBottomOf="@+id/tv_STR"
        app:layout_constraintStart_toEndOf="@+id/tv_STR"
        app:layout_constraintTop_toTopOf="@+id/imageView2"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@android:drawable/ic_media_play" />

    <ImageButton
        android:id="@+id/DEFbtn"
        android:layout_width="31dp"
        android:layout_height="27dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="85dp"
        android:contentDescription="Increase Defense"
        android:onClick="increaseDef"
        app:layout_constraintBottom_toBottomOf="@+id/tv_DEF"
        app:layout_constraintStart_toEndOf="@+id/tv_DEF"
        app:layout_constraintTop_toTopOf="@+id/imageView2"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@android:drawable/ic_media_play" />

    <ImageButton
        android:id="@+id/MGCbtn"
        android:layout_width="31dp"
        android:layout_height="27dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="127dp"
        android:contentDescription="Increase Magic"
        android:onClick="increaseMgc"
        app:layout_constraintBottom_toBottomOf="@+id/tv_MGC"
        app:layout_constraintStart_toEndOf="@+id/tv_MGC"
        app:layout_constraintTop_toTopOf="@+id/imageView2"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@android:drawable/ic_media_play" />

    <ImageButton
        android:id="@+id/AGIbtn"
        android:layout_width="31dp"
        android:layout_height="27dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="169dp"
        android:contentDescription="Increase Agility"
        android:onClick="increaseAgi"
        app:layout_constraintBottom_toBottomOf="@+id/tv_AGI"
        app:layout_constraintStart_toEndOf="@+id/tv_AGI"
        app:layout_constraintTop_toTopOf="@+id/imageView2"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@android:drawable/ic_media_play" />

    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="0dp"
        android:layout_height="158dp"
        android:layout_marginTop="1dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView2"
        app:srcCompat="@drawable/ic_launcher_background" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:text="EQUIPMENT:"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView2" />

    <ImageView
        android:id="@+id/weapon_slot"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="#44FFFFFF"
        app:layout_constraintEnd_toStartOf="@+id/helmet_slot"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2"
        app:srcCompat="@android:drawable/ic_menu_gallery" />

    <ImageView
        android:id="@+id/helmet_slot"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:background="#44FFFFFF"
        app:layout_constraintBottom_toBottomOf="@+id/weapon_slot"
        app:layout_constraintEnd_toStartOf="@+id/armor_slot"
        app:layout_constraintStart_toEndOf="@+id/weapon_slot"
        app:layout_constraintTop_toTopOf="@+id/weapon_slot"
        app:srcCompat="@android:drawable/ic_menu_gallery" />

    <ImageView
        android:id="@+id/armor_slot"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:background="#44FFFFFF"
        app:layout_constraintBottom_toBottomOf="@+id/weapon_slot"
        app:layout_constraintEnd_toStartOf="@+id/boots_slot"
        app:layout_constraintStart_toEndOf="@+id/helmet_slot"
        app:layout_constraintTop_toTopOf="@+id/weapon_slot"
        app:srcCompat="@android:drawable/ic_menu_gallery" />

    <ImageView
        android:id="@+id/boots_slot"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:background="#44FFFFFF"
        app:layout_constraintBottom_toBottomOf="@+id/weapon_slot"
        app:layout_constraintEnd_toStartOf="@+id/ring_slot"
        app:layout_constraintStart_toEndOf="@+id/armor_slot"
        app:layout_constraintTop_toTopOf="@+id/weapon_slot"
        app:srcCompat="@android:drawable/ic_menu_gallery" />

    <ImageView
        android:id="@+id/ring_slot"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:background="#44FFFFFF"
        app:layout_constraintBottom_toBottomOf="@+id/weapon_slot"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/boots_slot"
        app:layout_constraintTop_toTopOf="@+id/weapon_slot"
        app:srcCompat="@android:drawable/ic_menu_gallery" />

    <ImageView
        android:id="@+id/inventory_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView7"
        app:srcCompat="@drawable/inv_background" />

    <ImageView
        android:id="@+id/weapon_slot1"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="40dp"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView7" />

    <ImageView
        android:id="@+id/weapon_slot2"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:layout_marginStart="40dp"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toEndOf="@+id/weapon_slot1"
        app:layout_constraintTop_toTopOf="@+id/weapon_slot1" />

    <ImageView
        android:id="@+id/weapon_slot3"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:layout_marginStart="40dp"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toEndOf="@+id/weapon_slot2"
        app:layout_constraintTop_toTopOf="@+id/weapon_slot2" />

    <ImageView
        android:id="@+id/weapon_slot4"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:layout_marginStart="40dp"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toEndOf="@+id/weapon_slot3"
        app:layout_constraintTop_toTopOf="@+id/weapon_slot3" />

    <ImageView
        android:id="@+id/weapon_slot5"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="40dp"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="@+id/inventory_background"
        app:layout_constraintTop_toBottomOf="@+id/weapon_slot1" />

    <ImageView
        android:id="@+id/weapon_slot6"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:layout_marginStart="40dp"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toEndOf="@+id/weapon_slot5"
        app:layout_constraintTop_toTopOf="@+id/weapon_slot5" />

    <ImageView
        android:id="@+id/weapon_slot7"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:layout_marginStart="40dp"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toEndOf="@+id/weapon_slot6"
        app:layout_constraintTop_toTopOf="@+id/weapon_slot6" />

    <ImageView
        android:id="@+id/weapon_slot8"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:layout_marginStart="40dp"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toEndOf="@+id/weapon_slot7"
        app:layout_constraintTop_toTopOf="@+id/weapon_slot7" />

    <ImageButton
        android:id="@+id/imageButton2"
        android:layout_width="50dp"
        android:layout_height="40dp"
        android:layout_marginEnd="32dp"
        android:background="@android:color/transparent"
        android:onClick="INVnextPage"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/INVsitePage"
        app:layout_constraintEnd_toEndOf="@+id/inventory_background"
        app:layout_constraintTop_toTopOf="@+id/INVsitePage"
        app:srcCompat="@drawable/button_right" />

    <ImageButton
        android:id="@+id/imageButton3"
        android:layout_width="50dp"
        android:layout_height="40dp"
        android:layout_marginStart="32dp"
        android:background="@android:color/transparent"
        android:onClick="INVprevPage"
        android:rotationY="180"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/INVsitePage"
        app:layout_constraintStart_toStartOf="@+id/inventory_background"
        app:layout_constraintTop_toTopOf="@+id/INVsitePage"
        app:srcCompat="@drawable/button_right" />

    <TextView
        android:id="@+id/INVsitePage"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="1/3"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@+id/inventory_background"
        app:layout_constraintEnd_toEndOf="@+id/inventory_background"
        app:layout_constraintStart_toStartOf="@+id/inventory_background" />

    <!-- Item Description Panel (Hidden by default, appears over inventory) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/char_item_info_panel"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="#EE000000"
        android:padding="12dp"
        android:visibility="gone"
        android:elevation="15dp"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/selected_char_item_icon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/selected_char_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="Item Name"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/char_item_action_button"
            app:layout_constraintStart_toEndOf="@+id/selected_char_item_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/selected_char_item_desc"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/selected_char_item_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="Stats..."
            android:textColor="#BBBBBB"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@+id/char_item_action_button"
            app:layout_constraintStart_toEndOf="@+id/selected_char_item_icon"
            app:layout_constraintTop_toBottomOf="@+id/selected_char_item_name"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Buttons on the right side -->
        <Button
            android:id="@+id/char_item_action_button"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="EQUIP"
            android:backgroundTint="#4CAF50"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/char_item_close_button"
            app:layout_constraintVertical_chainStyle="packed" />

        <Button
            android:id="@+id/char_item_close_button"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="CLOSE"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="#FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/char_item_action_button"
            app:layout_constraintBottom_toBottomOf="parent" />
            
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:orientation="horizontal"
        android:background="#222222"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/shop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            app:srcCompat="@android:drawable/ic_menu_compass" />

        <ImageView
            android:id="@+id/skills"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            app:srcCompat="@android:drawable/ic_menu_manage" />

        <ImageView
            android:id="@+id/adventure"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            app:srcCompat="@android:drawable/ic_menu_mapmode" />

        <ImageView
            android:id="@+id/crafting"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            app:srcCompat="@android:drawable/ic_menu_edit" />

        <ImageView
            android:id="@+id/character"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            android:background="#44FFFFFF"
            app:srcCompat="@android:drawable/ic_menu_myplaces" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
