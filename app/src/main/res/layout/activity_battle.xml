<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/inv_background"
    tools:context=".BattleActivity">

    <!-- Monster Section (Top) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/monster_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@drawable/medium_background"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/monster_icon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="fitCenter"
            android:background="#22000000"
            android:padding="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@android:drawable/ic_menu_report_image" />

        <TextView
            android:id="@+id/monster_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Goblin"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            app:layout_constraintStart_toEndOf="@+id/monster_icon"
            app:layout_constraintTop_toTopOf="@+id/monster_icon" />

        <ProgressBar
            android:id="@+id/monster_hp_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            android:progressDrawable="@android:drawable/progress_horizontal"
            android:progressTint="#FF4444"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/monster_name"
            app:layout_constraintTop_toBottomOf="@+id/monster_name" />

        <TextView
            android:id="@+id/tv_monster_hp_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_hp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/monster_hp_bar"
            app:layout_constraintEnd_toEndOf="@+id/monster_hp_bar"
            app:layout_constraintStart_toStartOf="@+id/monster_hp_bar"
            app:layout_constraintTop_toTopOf="@+id/monster_hp_bar" />

        <ProgressBar
            android:id="@+id/monster_mana_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_marginTop="4dp"
            android:progressDrawable="@android:drawable/progress_horizontal"
            android:progressTint="#4444FF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/monster_name"
            app:layout_constraintTop_toBottomOf="@+id/monster_hp_bar" />

        <TextView
            android:id="@+id/tv_monster_mana_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_mana"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/monster_mana_bar"
            app:layout_constraintEnd_toEndOf="@+id/monster_mana_bar"
            app:layout_constraintStart_toStartOf="@+id/monster_mana_bar"
            app:layout_constraintTop_toTopOf="@+id/monster_mana_bar" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Battle Log (Middle) -->
    <ScrollView
        android:id="@+id/battle_log_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:background="@drawable/light_background"
        android:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/player_section"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/monster_section">

        <TextView
            android:id="@+id/battle_log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text=""
            android:textColor="#3E2723"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </ScrollView>

    <!-- Player Section (Bottom) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/player_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@drawable/medium_background"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/player_frame_layout"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/frame" />

            <ImageView
                android:id="@+id/player_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/maincharacter" />
        </FrameLayout>

        <TextView
            android:id="@+id/player_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/hero_name"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            app:layout_constraintStart_toEndOf="@+id/player_frame_layout"
            app:layout_constraintTop_toTopOf="parent" />

        <ProgressBar
            android:id="@+id/player_hp_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_marginTop="4dp"
            android:progressDrawable="@android:drawable/progress_horizontal"
            android:progressTint="#4CAF50"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/player_name"
            app:layout_constraintTop_toBottomOf="@+id/player_name" />

        <TextView
            android:id="@+id/tv_player_hp_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_hp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/player_hp_bar"
            app:layout_constraintEnd_toEndOf="@+id/player_hp_bar"
            app:layout_constraintStart_toStartOf="@+id/player_hp_bar"
            app:layout_constraintTop_toTopOf="@+id/player_hp_bar" />

        <ProgressBar
            android:id="@+id/player_mana_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_marginTop="4dp"
            android:progressDrawable="@android:drawable/progress_horizontal"
            android:progressTint="#2196F3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/player_name"
            app:layout_constraintTop_toBottomOf="@+id/player_hp_bar" />

        <TextView
            android:id="@+id/tv_player_mana_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_mana"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/player_mana_bar"
            app:layout_constraintEnd_toEndOf="@+id/player_mana_bar"
            app:layout_constraintStart_toStartOf="@+id/player_mana_bar"
            app:layout_constraintTop_toTopOf="@+id/player_mana_bar" />

        <!-- Skill Buttons -->
        <LinearLayout
            android:id="@+id/action_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/player_frame_layout">

            <!-- Basic Attack -->
            <ImageView
                android:id="@+id/btn_basic_attack"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_margin="6dp"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:elevation="4dp" />

            <!-- Dynamic Skill Slots -->
            <FrameLayout
                android:id="@+id/container_skill1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/skill_slot1"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="6dp"
                    android:background="@android:color/transparent"
                    android:padding="0dp"
                    android:scaleType="fitCenter"
                    android:elevation="4dp" />
                <TextView
                    android:id="@+id/tv_skill_cd1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:shadowColor="#000000"
                    android:shadowRadius="3"
                    android:text="2"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/container_skill2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/skill_slot2"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="6dp"
                    android:background="@android:color/transparent"
                    android:padding="0dp"
                    android:scaleType="fitCenter"
                    android:elevation="4dp" />
                <TextView
                    android:id="@+id/tv_skill_cd2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:shadowColor="#000000"
                    android:shadowRadius="3"
                    android:text="2"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/container_skill3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/skill_slot3"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="6dp"
                    android:background="@android:color/transparent"
                    android:padding="0dp"
                    android:scaleType="fitCenter"
                    android:elevation="4dp" />
                <TextView
                    android:id="@+id/tv_skill_cd3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:shadowColor="#000000"
                    android:shadowRadius="3"
                    android:text="2"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/container_skill4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/skill_slot4"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="6dp"
                    android:background="@android:color/transparent"
                    android:padding="0dp"
                    android:scaleType="fitCenter"
                    android:elevation="4dp" />
                <TextView
                    android:id="@+id/tv_skill_cd4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:shadowColor="#000000"
                    android:shadowRadius="3"
                    android:text="2"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>