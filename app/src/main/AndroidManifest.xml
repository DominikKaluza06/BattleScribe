<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/battlescribe"
        android:label="@string/app_name"
        android:roundIcon="@drawable/battlescribe"
        android:supportsRtl="true"
        android:theme="@style/Theme.BattleScribe">
        <activity
            android:name=".CraftingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".StoryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".BattleActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".BattleChoiceActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Character"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ShopActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".SkillsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>