<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/inv_background"
    tools:context=".ShopActivity">

    <!-- HEADER SECTION -->
    <ImageView
        android:id="@+id/header_bg"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/medium_background"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/shop_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_shop"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowRadius="3"
        app:layout_constraintBottom_toBottomOf="@+id/header_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- MAIN SCROLLABLE CONTENT -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:background="#88000000"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <!-- PLAYER GOLD -->
            <TextView
                android:id="@+id/tv_gold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gold: 0"
                android:textColor="#FFD700"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- SHOP SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_items_for_sale"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:id="@+id/shop_grid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:rowCount="2"
                android:background="@drawable/light_background"
                android:padding="12dp"
                android:layout_gravity="center_horizontal">

                <!-- Larger slots (75dp) for better visibility -->
                <ImageView android:id="@+id/shop_slot1" android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="4dp" android:background="#443E2723" android:padding="6dp" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/shop_slot2" android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="4dp" android:background="#443E2723" android:padding="6dp" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/shop_slot3" android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="4dp" android:background="#443E2723" android:padding="6dp" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/shop_slot4" android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="4dp" android:background="#443E2723" android:padding="6dp" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/shop_slot5" android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="4dp" android:background="#443E2723" android:padding="6dp" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/shop_slot6" android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="4dp" android:background="#443E2723" android:padding="6dp" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/shop_slot7" android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="4dp" android:background="#443E2723" android:padding="6dp" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/shop_slot8" android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="4dp" android:background="#443E2723" android:padding="6dp" android:scaleType="fitCenter"/>
            </GridLayout>

            <!-- PAGINATION -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">
                <ImageButton
                    android:id="@+id/shop_prev_page"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:background="@android:color/transparent"
                    android:onClick="SHOPprevPage"
                    android:rotationY="180"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/button_right" />
                <TextView
                    android:id="@+id/shop_page_text"
                    android:layout_width="60dp"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="1/3"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
                <ImageButton
                    android:id="@+id/shop_next_page"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:background="@android:color/transparent"
                    android:onClick="SHOPnextPage"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/button_right" />
            </LinearLayout>

            <!-- INVENTORY SECTION (FOR SELLING) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_your_inventory"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:id="@+id/inventory_grid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:rowCount="2"
                android:background="@drawable/light_background"
                android:padding="12dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp">

                <ImageView android:id="@+id/sell_slot1" android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="4dp" android:background="#443E2723" android:padding="6dp" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/sell_slot2" android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="4dp" android:background="#443E2723" android:padding="6dp" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/sell_slot3" android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="4dp" android:background="#443E2723" android:padding="6dp" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/sell_slot4" android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="4dp" android:background="#443E2723" android:padding="6dp" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/sell_slot5" android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="4dp" android:background="#443E2723" android:padding="6dp" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/sell_slot6" android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="4dp" android:background="#443E2723" android:padding="6dp" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/sell_slot7" android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="4dp" android:background="#443E2723" android:padding="6dp" android:scaleType="fitCenter"/>
                <ImageView android:id="@+id/sell_slot8" android:layout_width="75dp" android:layout_height="75dp" android:layout_margin="4dp" android:background="#443E2723" android:padding="6dp" android:scaleType="fitCenter"/>
            </GridLayout>

            <!-- ITEM INFO PANEL -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/item_info_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/medium_background"
                android:padding="16dp"
                android:visibility="invisible"
                android:elevation="10dp"
                android:layout_marginBottom="32dp">

                <ImageView
                    android:id="@+id/selected_item_icon"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:scaleType="fitCenter"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/selected_item_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/selected_item_icon"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/selected_item_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#DDDDDD"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/selected_item_name"
                    app:layout_constraintTop_toBottomOf="@+id/selected_item_name" />

                <Button
                    android:id="@+id/action_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#4CAF50"
                    android:text="ACTION"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/selected_item_desc" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </ScrollView>

    <!-- NAVIGATION MENU -->
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:background="#222222"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView android:id="@+id/shop_nav" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="12dp" android:background="#44FFFFFF" app:srcCompat="@android:drawable/ic_menu_compass" />
        <ImageView android:id="@+id/skills" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="12dp" app:srcCompat="@android:drawable/ic_menu_manage" />
        <ImageView android:id="@+id/adventure" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="12dp" app:srcCompat="@android:drawable/ic_menu_mapmode" />
        <ImageView android:id="@+id/crafting" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="12dp" app:srcCompat="@android:drawable/ic_menu_edit" />
        <ImageView android:id="@+id/character" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="12dp" app:srcCompat="@android:drawable/ic_menu_myplaces" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
