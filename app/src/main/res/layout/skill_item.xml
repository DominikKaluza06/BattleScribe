<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/light_background"
    android:padding="8dp"
    android:elevation="4dp">

    <ImageView
        android:id="@+id/skill_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:scaleType="fitCenter"
        android:background="#22000000"
        android:padding="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/skill_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Skill Name"
        android:textColor="#3E2723"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/tv_skill_requirement"
        app:layout_constraintStart_toEndOf="@+id/skill_icon"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_skill_requirement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Requires Lv 3"
        android:textColor="#B71C1C"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/skill_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:text="Skill Description goes here..."
        android:textColor="#5D4037"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/skill_name"
        app:layout_constraintTop_toBottomOf="@+id/skill_name" />

    <Button
        android:id="@+id/btn_skill_action"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:text="EQUIP"
        android:backgroundTint="#5D4037"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:padding="0dp"
        app:layout_constraintTop_toBottomOf="@+id/skill_desc"
        app:layout_constraintStart_toStartOf="@+id/skill_name" />

</androidx.constraintlayout.widget.ConstraintLayout>
