<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/inv_background"
    tools:context=".CraftingActivity">

    <!-- Overall Dark Filter -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- 1. Header Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/crafting_header"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="@drawable/medium_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/crafting_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_crafting"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Filter Bar - Fixed height to prevent expansion -->
    <HorizontalScrollView
        android:id="@+id/filter_scroll"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/inv_background"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@+id/crafting_header">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical">

            <Button android:id="@+id/filter_all" android:layout_width="wrap_content" android:layout_height="40dp" android:text="ALL" android:textSize="11sp" android:layout_marginEnd="8dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:textColor="#FFFFFF" app:strokeColor="#FFFFFF" />
            <Button android:id="@+id/filter_weapon" android:layout_width="wrap_content" android:layout_height="40dp" android:text="WEAPONS" android:textSize="11sp" android:layout_marginEnd="8dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:textColor="#FFFFFF" app:strokeColor="#FFFFFF" />
            <Button android:id="@+id/filter_armor" android:layout_width="wrap_content" android:layout_height="40dp" android:text="ARMOR" android:textSize="11sp" android:layout_marginEnd="8dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:textColor="#FFFFFF" app:strokeColor="#FFFFFF" />
            <Button android:id="@+id/filter_boots" android:layout_width="wrap_content" android:layout_height="40dp" android:text="BOOTS" android:textSize="11sp" android:layout_marginEnd="8dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:textColor="#FFFFFF" app:strokeColor="#FFFFFF" />
            <Button android:id="@+id/filter_helmet" android:layout_width="wrap_content" android:layout_height="40dp" android:text="HELMETS" android:textSize="11sp" android:layout_marginEnd="8dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:textColor="#FFFFFF" app:strokeColor="#FFFFFF" />
            <Button android:id="@+id/filter_ring" android:layout_width="wrap_content" android:layout_height="40dp" android:text="RINGS" android:textSize="11sp" android:layout_marginEnd="8dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:textColor="#FFFFFF" app:strokeColor="#FFFFFF" />
            <Button android:id="@+id/filter_materials" android:layout_width="wrap_content" android:layout_height="40dp" android:text="BARS" android:textSize="11sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:textColor="#FFFFFF" app:strokeColor="#FFFFFF" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- 2. Recipes Selection Grid -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recipe_section"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/light_background"
        app:layout_constraintBottom_toTopOf="@+id/separator_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/filter_scroll"
        app:layout_constraintVertical_weight="1.2">

        <TextView
            android:id="@+id/label_recipes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:text="@string/label_recipes"
            android:textColor="#3E2723"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <GridLayout
            android:id="@+id/recipe_grid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="2"
            app:layout_constraintBottom_toTopOf="@+id/recipe_page_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/label_recipes">

            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="6dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/recipe_slot1" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="6dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/recipe_slot2" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="6dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/recipe_slot3" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="6dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/recipe_slot4" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="6dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/recipe_slot5" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="6dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/recipe_slot6" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="6dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/recipe_slot7" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="6dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame" android:scaleType="fitXY" />
                <ImageView android:id="@+id/recipe_slot8" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:scaleType="fitCenter" />
            </FrameLayout>
        </GridLayout>

        <ImageButton
            android:id="@+id/recipe_prev_page"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:layout_marginStart="32dp"
            android:background="@android:color/transparent"
            android:onClick="RECIPEprevPage"
            android:rotationY="180"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/recipe_page_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/recipe_page_text"
            app:srcCompat="@drawable/button_right" />

        <TextView
            android:id="@+id/recipe_page_text"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="1/1"
            android:textColor="#3E2723"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/recipe_next_page"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:layout_marginEnd="32dp"
            android:background="@android:color/transparent"
            android:onClick="RECIPEnextPage"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/recipe_page_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/recipe_page_text"
            app:srcCompat="@drawable/button_right" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Separator Line -->
    <View
        android:id="@+id/separator_line"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#3E2723"
        app:layout_constraintBottom_toTopOf="@+id/crafting_panel"
        app:layout_constraintTop_toBottomOf="@+id/recipe_section" />

    <!-- 3. Crafting Panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/crafting_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/light_background"
        android:padding="12dp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/nav_top_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/separator_line"
        app:layout_constraintVertical_weight="1">

        <ImageView
            android:id="@+id/selected_recipe_icon"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/selected_recipe_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text=""
            android:textColor="#3E2723"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btn_craft"
            app:layout_constraintStart_toEndOf="@+id/selected_recipe_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_requirements"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_required_materials"
            android:textColor="#3E2723"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="@+id/selected_recipe_name"
            app:layout_constraintTop_toBottomOf="@+id/selected_recipe_name" />

        <HorizontalScrollView
            android:id="@+id/horizontalScrollView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_craft"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_requirements">

            <LinearLayout
                android:id="@+id/requirements_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/btn_craft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#4CAF50"
            android:text="@string/btn_craft"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Material Source Panel (Tooltip style) with dark_brown background -->
        <androidx.cardview.widget.CardView
            android:id="@+id/mat_source_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="8dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="@color/dark_brown"
            app:layout_constraintBottom_toTopOf="@+id/horizontalScrollView"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:id="@+id/tv_mat_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Source Info"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 4. Bottom Navigation -->
    <View
        android:id="@+id/nav_top_line"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#3E2723"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/light_background"
        android:elevation="10dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView android:id="@+id/shop" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="12dp" app:srcCompat="@drawable/shop" />
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#3E2723" />
        <ImageView android:id="@+id/skills" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="0dp" app:srcCompat="@drawable/skills" />
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#3E2723" />
        <ImageView android:id="@+id/adventure" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="12dp" app:srcCompat="@drawable/map" />
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#3E2723" />
        <ImageView android:id="@+id/crafting" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#44FFFFFF" android:padding="12dp" app:srcCompat="@drawable/crafting" />
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#3E2723" />
        <ImageView android:id="@+id/character" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="12dp" app:srcCompat="@drawable/charcter" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>