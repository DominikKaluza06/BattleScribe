<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ShopActivity">

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="0dp"
        android:layout_height="241dp"
        android:background="#333333"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Shop Title / Header -->
    <TextView
        android:id="@+id/shop_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SHOP"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/imageView2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/shop_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView2"
        app:srcCompat="@drawable/inv_background"
        tools:srcCompat="@drawable/inv_background" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="ITEMS FOR SALE:"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/shop_background" />

    <!-- Shop Slots -->
    <ImageView
        android:id="@+id/shop_slot1"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"
        android:background="#44FFFFFF"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2"
        tools:srcCompat="@tools:sample/avatars" />

    <ImageView
        android:id="@+id/shop_slot2"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:layout_marginStart="40dp"
        android:background="#44FFFFFF"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintStart_toEndOf="@+id/shop_slot1"
        app:layout_constraintTop_toTopOf="@+id/shop_slot1"
        tools:srcCompat="@tools:sample/avatars" />

    <ImageView
        android:id="@+id/shop_slot3"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:layout_marginStart="40dp"
        android:background="#44FFFFFF"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintStart_toEndOf="@+id/shop_slot2"
        app:layout_constraintTop_toTopOf="@+id/shop_slot2"
        tools:srcCompat="@tools:sample/avatars" />

    <ImageView
        android:id="@+id/shop_slot4"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:layout_marginStart="40dp"
        android:background="#44FFFFFF"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintStart_toEndOf="@+id/shop_slot3"
        app:layout_constraintTop_toTopOf="@+id/shop_slot3"
        tools:srcCompat="@tools:sample/avatars" />

    <ImageView
        android:id="@+id/shop_slot5"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:background="#44FFFFFF"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shop_slot1"
        tools:srcCompat="@tools:sample/avatars" />

    <ImageView
        android:id="@+id/shop_slot6"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:layout_marginStart="40dp"
        android:background="#44FFFFFF"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintStart_toEndOf="@+id/shop_slot5"
        app:layout_constraintTop_toTopOf="@+id/shop_slot5"
        tools:srcCompat="@tools:sample/avatars" />

    <ImageView
        android:id="@+id/shop_slot7"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:layout_marginStart="40dp"
        android:background="#44FFFFFF"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintStart_toEndOf="@+id/shop_slot6"
        app:layout_constraintTop_toTopOf="@+id/shop_slot6"
        tools:srcCompat="@tools:sample/avatars" />

    <ImageView
        android:id="@+id/shop_slot8"
        android:layout_width="55dp"
        android:layout_height="56dp"
        android:layout_marginStart="40dp"
        android:background="#44FFFFFF"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintStart_toEndOf="@+id/shop_slot7"
        app:layout_constraintTop_toTopOf="@+id/shop_slot7"
        tools:srcCompat="@tools:sample/avatars" />

    <Button
        android:id="@+id/buy_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BUY"
        android:onClick="buyItem"
        app:layout_constraintBottom_toTopOf="@+id/shop_page_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="8dp" />

    <ImageButton
        android:id="@+id/shop_next_page"
        android:layout_width="50dp"
        android:layout_height="40dp"
        android:layout_marginEnd="32dp"
        android:background="@android:color/transparent"
        android:onClick="SHOPnextPage"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/shop_page_text"
        app:layout_constraintEnd_toEndOf="@+id/shop_background"
        app:layout_constraintTop_toTopOf="@+id/shop_page_text"
        app:srcCompat="@drawable/button_right" />

    <ImageButton
        android:id="@+id/shop_prev_page"
        android:layout_width="50dp"
        android:layout_height="40dp"
        android:layout_marginStart="32dp"
        android:background="@android:color/transparent"
        android:onClick="SHOPprevPage"
        android:rotationY="180"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/shop_page_text"
        app:layout_constraintStart_toStartOf="@+id/shop_background"
        app:layout_constraintTop_toTopOf="@+id/shop_page_text"
        app:srcCompat="@drawable/button_right" />

    <TextView
        android:id="@+id/shop_page_text"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="1/3"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@+id/shop_background"
        app:layout_constraintEnd_toEndOf="@+id/shop_background"
        app:layout_constraintStart_toStartOf="@+id/shop_background" />

    <!-- NAVIGATION MENU -->
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:orientation="horizontal"
        android:background="#222222"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/shop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            android:background="#44FFFFFF"
            app:srcCompat="@android:drawable/ic_menu_compass"
            tools:srcCompat="@tools:sample/avatars" />

        <ImageView
            android:id="@+id/skills"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            app:srcCompat="@android:drawable/ic_menu_manage"
            tools:srcCompat="@tools:sample/avatars" />

        <ImageView
            android:id="@+id/map"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            app:srcCompat="@android:drawable/ic_menu_mapmode"
            tools:srcCompat="@tools:sample/avatars" />

        <ImageView
            android:id="@+id/crafting"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            app:srcCompat="@android:drawable/ic_menu_edit"
            tools:srcCompat="@tools:sample/avatars" />

        <ImageView
            android:id="@+id/character"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            app:srcCompat="@android:drawable/ic_menu_myplaces"
            tools:srcCompat="@tools:sample/avatars" />
    </LinearLayout>

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="252dp"
        android:text="NAREDI POZNEJE"
        android:textColor="@color/white"
        android:textSize="34sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView2" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="Item description"
        android:textColor="@color/white"
        android:textSize="34sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView4" />

</androidx.constraintlayout.widget.ConstraintLayout>